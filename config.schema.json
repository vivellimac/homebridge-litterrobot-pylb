{
  "pluginAlias": "LitterRobotPylb",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "platform": { "type": "string", "const": "LitterRobotPylb" },
      "name": { "type": "string", "default": "Litter-Robot" },
      "username": { "type": "string", "title": "Whisker Email" },
      "password": { "type": "string", "title": "Whisker Password" },
      "python": { "type": "string", "title": "Python Executable", "default": "/usr/bin/python3" },
      "workdir": { "type": "string", "title": "Sidecar Work Dir (HB host)", "default": "/var/lib/homebridge/lr-sidecar" },
      "host": { "type": "string", "default": "127.0.0.1", "title": "Sidecar Host" },
      "port": { "type": "integer", "default": 8765, "title": "Sidecar Port" },
      "pollInterval": { "type": "number", "default": 5000, "minimum": 3000, "maximum": 60000 },
      "pulseMs": { "type": "number", "default": 1500, "minimum": 250, "maximum": 10000 },
      "debug": {
        "type": "boolean",
        "title": "Verbose Status Heartbeat",
        "default": false
      },
      "advanced": {
        "type": "object",
        "title": "Advanced",
        "properties": {
          "drawerControls": {
            "type": "boolean",
            "title": "Enable Drawer Controls (Drawer % sensor + Reset switch)",
            "default": false
          },
          "litterPercent": {
            "type": "boolean",
            "title": "Expose Litter % Sensor",
            "default": false
          },
          "interruptTimeoutEnabled": {
            "type": "boolean",
            "title": "Enable Cycle-Interrupt Timeout Alert",
            "default": false
          },
          "interruptTimeoutMinutes": {
            "type": "number",
            "title": "Cycle-Interrupt Timeout (minutes)",
            "default": 10,
            "minimum": 1,
            "maximum": 120
          }
        }
    },
    "required": ["username", "password"]
},
  "layout": [
    "username",
    "password",
    "port",
    "workdir",
    { "key": "debug", "type": "checkbox", "advanced": true },
    {
      "key": "advanced",
      "type": "fieldset",
      "advanced": true,
      "items": [
        "advanced.drawerControls",
        "advanced.litterPercent",
        "advanced.interruptTimeoutEnabled",
        "advanced.interruptTimeoutMinutes"
      ]
    }
  ]
}
