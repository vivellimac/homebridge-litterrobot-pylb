{
  "pluginAlias": "LitterRobotPylb",
  "pluginType": "platform",
  "singular": true,

  "schema": {
    "type": "object",
    "properties": {
      "username": { "type": "string", "title": "Account Email" },
      "password": { "type": "string", "title": "Account Password" },

      "switches": {
        "type": "object",
        "title": "Switches",
        "properties": {
          "cycleNow":   { "type": "boolean", "title": "Cycle Now",   "default": true },
          "globeLight": { "type": "boolean", "title": "Globe Light", "default": true }
        }
      },

      "sensors": {
        "type": "object",
        "title": "Sensors",
        "properties": {
          "cycleCompleted": { "type": "boolean", "title": "Cycle Completed", "default": true },
          "cycleFault":     { "type": "boolean", "title": "Cycle Fault",     "default": true },
          "pinch":          { "type": "boolean", "title": "Pinch (safety)",  "default": true },
          "offline":        { "type": "boolean", "title": "Offline",         "default": true }
        }
      },

      "advanced": {
        "type": "object",
        "title": "Advanced",
        "properties": {
          "debug": {
            "type": "boolean",
            "title": "Enable debug/heartbeat logs",
            "default": false
          },

          "port": {
            "type": "number",
            "title": "Sidecar Port",
            "default": 8765,
            "minimum": 1,
            "maximum": 65535,
            "description": "Leave as 8765 unless you know what you're doing."
          },

          "workdir": {
            "type": "string",
            "title": "Sidecar Workdir",
            "default": "/home/homebridge/lr-sidecar",
            "description": "Leave as default unless you know what you're doing."
          },

          "bonnetSensor": {
            "type": "boolean",
            "title": "Expose Bonnet Sensor (Advanced)",
            "default": false
          },

          "drawer": {
            "type": "object",
            "title": "Drawer Controls",
            "properties": {
              "enable":      { "type": "boolean", "title": "Expose Drawer % sensor",      "default": false },
              "resetSwitch": { "type": "boolean", "title": "Expose Reset Drawer switch",  "default": false }
            }
          },

          "litter": {
            "type": "object",
            "title": "Litter Level",
            "properties": {
              "enable": { "type": "boolean", "title": "Expose Litter % sensor", "default": false }
            }
          },

          "cycleInterrupt": {
            "type": "object",
            "title": "Cycle Interrupt Timeout",
            "properties": {
              "enabled": { "type": "boolean", "title": "Enable interrupt timeout alert", "default": false },
              "minutes": { "type": "number",  "title": "Minutes before alert", "default": 5, "minimum": 1, "maximum": 120 }
            }
          }
        }
      }
    },
    "required": ["username", "password"]
  },

  "layout": [
    {
      "type": "fieldset",
      "title": "Account",
      "items": [ "username", "password" ]
    },

    {
      "type": "fieldset",
      "title": "Accessories",
      "items": [
        {
          "type": "fieldset",
          "title": "Switches",
          "items": [
            "switches.cycleNow",
            "switches.globeLight"
          ]
        },
        {
          "type": "fieldset",
          "title": "Sensors",
          "items": [
            "sensors.cycleCompleted",
            "sensors.cycleFault",
            "sensors.pinch",
            "sensors.offline"
          ]
        }
      ]
    },

    {
      "type": "fieldset",
      "title": "Advanced",
      "items": [
        "advanced.debug",
        "advanced.port",
        "advanced.workdir",
        "advanced.bonnetSensor",
        {
          "type": "fieldset",
          "title": "Drawer Controls",
          "items": [
            "advanced.drawer.enable",
            "advanced.drawer.resetSwitch"
          ]
        },
        {
          "type": "fieldset",
          "title": "Litter Level",
          "items": [
            "advanced.litter.enable"
          ]
        },
        {
          "type": "fieldset",
          "title": "Cycle Interrupt Timeout",
          "items": [
            "advanced.cycleInterrupt.enabled",
            "advanced.cycleInterrupt.minutes"
          ]
        }
      ]
    }
  ]
}
